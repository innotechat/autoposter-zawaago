{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoposter-zawaago",
  "compatibility_date": "2025-10-08",
  "main": "./workers/app.ts",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "zawaago-autoposter-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoposter-db",
      "database_id": "autoposter-d1-local"
    }
  ],
  "vars": {
    "PAGE_ID_ZAWAAGO": "113167943749510",
    "PAGE_ID_INNOTECH": "102440764818837"
  }
}
