{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoposter-zawaago",
  "compatibility_date": "2025-10-08",
  "main": "./workers/app.ts",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "containers": [
    {
      "class_name": "ReelRenderer",
      "image": "./container/reel-renderer/Dockerfile",
      "image_build_context": "./container/reel-renderer",
      "name": "autoposter-reel-renderer",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REEL_RENDERER", "class_name": "ReelRenderer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReelRenderer"] }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "zawaago-autoposter-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoposter-db",
      "database_id": "66e2ee5d-6c9e-4760-8734-7a2553b85e4c"
    }
  ],
  "vars": {
    "PAGE_ID_ZAWAAGO": "113167943749510",
    "PAGE_ID_INNOTECH": "102440764818837"
  }
}
